@using DACS.Extention
@using DACS.Models
@using YourNameSpace.Extensions

@{
    var cart = Context.Session.GetObjectFromJson<ShoppingCart>("Cart") ?? new ShoppingCart();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nền tảng Nông nghiệp Tuần hoàn Saikahana</title>

    <!-- Font & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

    <!-- Libraries -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper/swiper-bundle.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body>

    <!-- HEADER: Dùng header-container để bóp lề cho đẹp -->
    <header class="site-header">
        <!-- 1. Top Bar -->
        <div class="top-bar">
            <div class="header-container d-flex justify-content-between align-items-center">
                <div class="socials d-none d-md-flex align-items-center">
                    <span class="me-3"><i class="fa-solid fa-phone me-1"></i> Hotline: 1900 xxxx</span>
                    <a href="#"><i class="fa-brands fa-facebook"></i></a>
                    <a href="#"><i class="fa-brands fa-youtube"></i></a>
                    <a href="#"><i class="fa-brands fa-tiktok"></i></a>
                </div>
                <div class="user-auth">
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </div>

        <!-- 2. Middle Bar -->
        <div class="middle-bar">
            <div class="header-container d-flex justify-content-between align-items-center">
                <!-- Logo -->
                <a href="/home/index" class="logo-wrapper">
                    <img src="/images/hana.png" alt="Saikahana Logo" class="logo-img" />
                </a>

                <!-- Controls -->
                <div class="header-controls">
                    <!-- Search -->
                    <button class="control-btn search-button" id="openSearchBtn">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>

                    <!-- Yêu thích -->
                    <div class="dropdown wishlist-dropdown">
                        <button class="control-btn" id="wishlist-dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fa-regular fa-heart"></i>
                            <span class="badge-count" id="wishlist-count"><i class="fas fa-spinner fa-spin" style="font-size:10px;"></i></span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end" aria-labelledby="wishlist-dropdown-toggle" id="wishlist-mini-dropdown">
                            <h6 class="dropdown-header">Sản phẩm yêu thích</h6>
                            <div id="wishlist-mini-items" style="max-height: 300px; overflow-y: auto;">
                                <p class="text-center px-3 small text-muted my-3">Đang tải...</p>
                            </div>
                            <div class="dropdown-divider"></div>
                            <a href="@Url.Action("Index", "Wishlist")" class="dropdown-item text-center text-primary fw-bold">Xem tất cả</a>
                        </div>
                    </div>

                    <!-- Giỏ hàng -->
                    <div class="dropdown cart-dropdown">
                        <button class="control-btn" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fa-solid fa-cart-shopping"></i>
                            @{
                                float totalItems = 0;
                                if (cart?.Items != null) { foreach (var i in cart.Items) { totalItems += i.Quantity; } }
                            }
                            <span class="badge-count" id="dropid">@totalItems</span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end p-3">
                            <h6 class="mb-3 fw-bold border-bottom pb-2">Giỏ hàng của bạn</h6>
                            <ul class="list-unstyled mb-3" id="cart-items">
                                @if (cart?.Items != null && cart.Items.Any() && (User.IsInRole("KhachHang") || User.IsInRole("Owner") || User.IsInRole("QuanLyXNK") || User.IsInRole("QuanLyND") || User.IsInRole("QuanLySP") || User.IsInRole("QuanLyDH")))
                                {
                                    float total = 0;
                                    @foreach (var item in cart.Items)
                                    {
                                        total += item.Price * item.Quantity;
                                        <li class="d-flex justify-content-between mb-3 border-bottom pb-2">
                                            <div>
                                                <h6 class="mb-0 text-truncate" style="max-width: 180px;"><a href="#" class="text-dark text-decoration-none">@item.Name</a></h6>
                                                <small class="text-muted">SL: @item.Quantity</small>
                                            </div>
                                            <span class="fw-bold text-success">@String.Format("{0:N0}", item.Price * item.Quantity) ₫</span>
                                        </li>
                                    }
                                    <li class="d-flex justify-content-between mt-2">
                                        <span class="fw-bold">Tổng cộng:</span>
                                        <strong class="text-danger">@String.Format("{0:N0}", total) ₫</strong>
                                    </li>
                                }
                                else
                                {
                                    <li class="text-center text-muted py-3">Giỏ hàng trống.</li>
                                }
                            </ul>
                            <a href="/ShoppingCart/Index" class="btn btn-success w-100 rounded-pill">Xem chi tiết giỏ hàng</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Bottom Nav -->
        <nav class="bottom-nav navbar navbar-expand-lg">
            <div class="header-container d-flex justify-content-between align-items-center">

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainMenu" aria-controls="mainMenu" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="fa-solid fa-bars"></i>
                </button>

                <div class="collapse navbar-collapse" id="mainMenu">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" href="/home/index">Trang chủ</a></li>
                        <li class="nav-item"><a class="nav-link" href="/home/Introduction">Giới thiệu</a></li>

                        <li class="nav-item dropdown-hover-container">
                            <a class="nav-link" asp-controller="DS_SP" asp-action="Index">Danh Mục Cung Cấp <i class="fa-solid fa-chevron-down ms-1" style="font-size:12px;"></i></a>
                            <div class="mega-menu-content">
                                <div class="row">
                                    <div class="col-md-3">
                                        <h6 class="fw-bold text-success border-bottom pb-2">Nguyên liệu thô</h6>
                                        <ul class="list-unstyled">
                                            <li><a asp-controller="DS_SP" asp-action="PhuPhamTho">Xem tất cả nguyên liệu</a></li>
                                        </ul>
                                    </div>
                                    <div class="col-md-3">
                                        <h6 class="fw-bold text-success border-bottom pb-2">Đã qua xử lý</h6>
                                        <ul class="list-unstyled">
                                            <li><a asp-controller="DS_SP" asp-action="DaQuaXuLy">Sản phẩm tinh chế</a></li>
                                        </ul>
                                    </div>
                                    <div class="col-md-3">
                                        <h6 class="fw-bold text-success border-bottom pb-2">Thức ăn chăn nuôi</h6>
                                        <ul class="list-unstyled">
                                            <li><a asp-controller="DS_SP" asp-action="ThucAnChanNuoi">Phụ phẩm chăn nuôi</a></li>
                                        </ul>
                                    </div>
                                    <div class="col-md-3">
                                        <h6 class="fw-bold text-success border-bottom pb-2">Khác</h6>
                                        <ul class="list-unstyled">
                                            <li><a asp-controller="DS_SP" asp-action="PhanBon">Phân bón & Giá thể</a></li>
                                            <li><a asp-controller="DS_SP" asp-action="NangLuongSinhKhoi">Năng lượng sinh khối</a></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </li>

                        <li class="nav-item"><a class="nav-link" asp-controller="ThuGom" asp-action="Index">Đặt thu gom</a></li>
                        <li class="nav-item"><a class="nav-link" href="/home/News">Tin tức</a></li>
                        <li class="nav-item"><a class="nav-link" href="/home/contact">Liên Hệ</a></li>
                    </ul>
                </div>

                <div class="ai-button-wrapper d-none d-lg-block">
                    <a class="ai-highlight" href="/home/ExpertAi">
                        <i class="fa-solid fa-robot"></i> Chuyên gia AI
                    </a>
                </div>

            </div>
        </nav>
    </header>

    <!-- SEARCH POPUP -->
    <div class="search-popup" id="searchPopup">
        <div class="search-popup-container">
            <button class="close-btn" id="closeSearch">&times;</button>
            <h4 class="mb-4 text-center fw-bold">Bạn cần tìm phụ phẩm gì?</h4>
            <form action="/DS_SP/TimKiem" method="get" class="position-relative">
                <input type="text" id="searchBox" name="keyword" placeholder="Nhập từ khóa (VD: Bã mía, Vỏ trấu...)" autocomplete="off" />
                <button type="submit" class="btn btn-success position-absolute top-50 end-0 translate-middle-y me-2 rounded-pill px-4">Tìm</button>
                <div id="suggestions" class="list-group position-absolute w-100 mt-1 shadow" style="z-index:1000; display:none;"></div>
            </form>
            <div class="mt-4">
                <p class="text-muted small mb-2">Từ khóa phổ biến:</p>
                <div class="d-flex flex-wrap gap-2">
                    <a href="/DS_SP/TimKiem?keyword=b%C3%A3+m%C3%ADa" class="badge bg-light text-dark border text-decoration-none py-2 px-3">Bã mía</a>
                    <a href="/DS_SP/TimKiem?keyword=Trấu+nghiền" class="badge bg-light text-dark border text-decoration-none py-2 px-3">Trấu nghiền</a>
                    <a href="/DS_SP/TimKiem?keyword=Xơ+dừa" class="badge bg-light text-dark border text-decoration-none py-2 px-3">Xơ dừa</a>
                    <a href="/DS_SP/TimKiem?keyword=Phân+compost" class="badge bg-light text-dark border text-decoration-none py-2 px-3">Phân compost</a>
                </div>
            </div>
        </div>
    </div>

    <!-- MAIN BODY: ĐÃ GỠ LỚP ÉP LỀ ĐỂ TRẢ LẠI GIAO DIỆN GỐC CỦA BẠN -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- FOOTER: ĐÃ GỠ LỚP ÉP LỀ CHỈ GIỮ LẠI LỚP CONTAINER CỦA BOOTSTRAP -->
    <footer class="end-footer">
        <div class="container">
            <div class="row">
                <div class="col-lg-3 col-md-6 mb-4">
                    <h4>Về nền tảng Saikahana</h4>
                    <p class="small text-muted mb-3" style="color: #a3b8ad !important; line-height: 1.6;">Nền tảng tiên phong trong việc thu gom và tái chế phụ phẩm nông nghiệp, hướng tới nền nông nghiệp tuần hoàn bền vững tại Việt Nam.</p>
                    <div class="social-link">
                        <a href="#"><i class="fa-brands fa-facebook-f"></i></a>
                        <a href="#"><i class="fa-brands fa-youtube"></i></a>
                        <a href="#"><i class="fa-brands fa-tiktok"></i></a>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <h4>Về chúng tôi</h4>
                    <ul class="list-unstyled">
                        <li><a href="#">Giới thiệu nền tảng</a></li>
                        <li><a href="#">Sứ mệnh & Tầm nhìn</a></li>
                        <li><a href="#">Chính sách bảo mật</a></li>
                        <li><a href="#">Hợp tác doanh nghiệp</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <h4>Dịch vụ</h4>
                    <ul class="list-unstyled">
                        <li><a href="#">Đăng bán phụ phẩm</a></li>
                        <li><a href="#">Đặt lịch thu mua tận nơi</a></li>
                        <li><a href="#">Tư vấn tái chế hữu cơ</a></li>
                        <li><a href="#">Báo cáo môi trường</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <h4>Liên hệ hỗ trợ</h4>
                    <ul class="list-unstyled">
                        <li><a href="#"><i class="fa-solid fa-location-dot me-2"></i>Khu Công Nghệ Cao, TP.HCM</a></li>
                        <li><a href="#"><i class="fa-solid fa-phone me-2"></i>1900 xxxx</a></li>
                        <li><a href="#"><i class="fa-solid fa-envelope me-2"></i>hotro@saikahana.vn</a></li>
                    </ul>
                </div>
            </div>
            <div class="border-top border-secondary mt-4 pt-4 text-center small">
                &copy; 2026 Saikahana - Nền tảng Nông nghiệp Tuần hoàn. Đồ án tốt nghiệp.
            </div>
        </div>
    </footer>

    <!-- SCRIPTS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Search Popup Toggle -->
    <script>
        $(document).ready(function() {
            $('.search-button').on('click', function() {
                $('#searchPopup').addClass('active');
            });
            $('#closeSearch, .search-popup').on('click', function(e) {
                if(e.target === this) {
                    $('#searchPopup').removeClass('active');
                }
            });
        });
    </script>

    <!-- Suggestion Search Ajax -->
    <script>
        $(document).ready(function () {
            $('#searchBox').on('input', function () {
                const keyword = $(this).val();
                if (keyword.length === 0) {
                    $('#suggestions').empty().hide();
                    return;
                }
                $.ajax({
                    url: '/DS_SP/Suggest',
                    type: 'GET',
                    data: { keyword: keyword },
                    success: function (data) {
                        $('#suggestions').empty();
                        if (data.length > 0) {
                            $('#suggestions').show();
                            data.forEach(function (item) {
                                $('#suggestions').append(`
                                    <a href="#" class="list-group-item list-group-item-action suggestion-item"
                                       data-name="${item.tenSanPham}" data-id="${item.m_SanPham}">
                                        ${item.tenSanPham}
                                    </a>
                                `);
                            });
                        } else {
                            $('#suggestions').hide();
                        }
                    }
                });
            });

            $(document).on('click', '.suggestion-item', function (e) {
                e.preventDefault();
                const name = $(this).data('name');
                $('#searchBox').val(name);
                $('#suggestions').hide();
            });
        });
    </script>

    <!-- Mini Wishlist Ajax -->
    <script type="text/javascript">
        function loadWishlistMini() {
            $.ajax({
                url: '/DS_SP/GetWishlistMini',
                type: 'GET',
                success: function (data) {
                    $('#wishlist-count').text(data.total);
                    var itemsContainer = $('#wishlist-mini-items');
                    itemsContainer.empty();

                    if (data.total > 0) {
                        $.each(data.items, function (index, item) {
                            var formattedPrice = item.gia.toLocaleString('vi-VN') + ' đ';
                            var itemHtml =
                                '<a class="dropdown-item d-flex align-items-center py-2 border-bottom" href="/DS_SP/CT_SP/' + item.m_SanPham + '">' +
                                '    <img src="' + (item.hinhAnh ? item.hinhAnh : '/images/placeholder.png') + '" alt="' + item.tenSanPham + '" style="width: 45px; height: 45px; object-fit: cover; margin-right: 12px; border-radius: 6px;">' +
                                '    <div style="line-height: 1.4; width: 100%;">' +
                                '        <div class="small fw-bold text-dark text-truncate" style="max-width: 200px;">' + item.tenSanPham + '</div>' +
                                '        <small class="text-success fw-bold">' + formattedPrice + '</small>' +
                                '    </div>' +
                                '</a>';
                            itemsContainer.append(itemHtml);
                        });
                    } else {
                        itemsContainer.append('<p class="text-center px-3 small text-muted my-3">Chưa có sản phẩm yêu thích.</p>');
                    }
                },
                error: function () {
                    $('#wishlist-count').text('0');
                }
            });
        }

        $(document).ready(function () {
            loadWishlistMini();
        });
    </script>

    <!-- Update Cart Stats -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            function updateCartStats() {
                const uniqueIds = new Set();
                const inputs = document.querySelectorAll(".soLuongInput");
                let totalQuantity = 0;

                inputs.forEach(input => {
                    const productId = input.dataset.target;
                    if (uniqueIds.has(productId)) return;

                    const quantity = parseFloat(input.value);
                    if (!isNaN(quantity)) {
                        totalQuantity += quantity;
                        uniqueIds.add(productId);
                    }
                });

                if(inputs.length > 0){
                    const dropid = document.getElementById("dropid");
                    if (dropid) dropid.textContent = Math.floor(totalQuantity);
                }
            }

            updateCartStats();
            document.querySelectorAll(".soLuongInput").forEach(input => {
                input.addEventListener("input", updateCartStats);
            });
        });
    </script>

    <!-- Active Nav Link -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let currentPath = window.location.pathname.toLowerCase();
            if (currentPath.length > 1 && currentPath.endsWith('/')) {
                currentPath = currentPath.slice(0, -1);
            }
            const homePaths = ["/", "/home", "/home/index"];
            const isCurrentPageHome = homePaths.includes(currentPath);
            const navLinks = document.querySelectorAll(".navbar-nav .nav-link");

            navLinks.forEach(link => {
                const linkHref = link.getAttribute("href");
                if (!linkHref || linkHref === "#") return;

                let linkPath = linkHref.toLowerCase();
                if (linkPath.length > 1 && linkPath.endsWith('/')) {
                    linkPath = linkPath.slice(0, -1);
                }

                let isActive = false;
                if (isCurrentPageHome && homePaths.includes(linkPath)) {
                    isActive = true;
                } else if (!isCurrentPageHome && currentPath === linkPath) {
                    isActive = true;
                }

                if (isActive) link.classList.add("active");
                else link.classList.remove("active");
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>