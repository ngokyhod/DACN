@model DACS.Models.DonHang
@{
    ViewData["Title"] = $"Chi tiết đơn hàng {Model.M_DonHang}";

    // BẮT BUỘC: Đặt Layout = null vì bên dưới chúng ta đã xây dựng sẵn bộ khung HTML <html> và <body> riêng
    Layout = null;

    var orderStatusBadgeClass = ViewData["OrderStatusBadgeClass"] as string ?? "badge bg-secondary";
    var paymentStatusText = ViewData["PaymentStatusText"] as string ?? "Chưa rõ";
    var paymentStatusBadgeClass = ViewData["PaymentStatusBadgeClass"] as string ?? "badge bg-light text-dark";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        body {
            background-color: #f4f6f9;
            margin: 0;
            overflow: hidden; /* Ngăn scroll toàn trang, chỉ scroll phần nội dung */
        }

        /* BỘ KHUNG CHUẨN ÉP GIAO DIỆN FULL MÀN HÌNH */
        .wrapper-layout {
            display: flex;
            height: 100vh;
            width: 100vw;
        }

        /* KHU VỰC MENU TRÁI */
        .sidebar {
            background-color: #212529;
            color: #fff;
            padding: 15px;
            width: 250px;
            flex-shrink: 0;
            overflow-y: auto;
        }

            .sidebar h2 {
                border-bottom: 1px solid #495057;
                padding-bottom: 10px;
                font-size: 1.5rem;
            }

            .sidebar .nav-link {
                color: #adb5bd;
                padding: 8px 15px;
            }

                .sidebar .nav-link.active, .sidebar .nav-link:hover {
                    color: #fff;
                    background-color: #495057;
                    border-radius: 0.25rem;
                }

        /* KHU VỰC NỘI DUNG CHÍNH (ĐÃ FIX LỖI HỤT PHẢI) */
        .main-content-area {
            flex: 1; /* Lệnh này bắt buộc nội dung phải dãn chiếm toàn bộ không gian còn lại */
            min-width: 0; /* Lệnh này chống vỡ khung Flexbox */
            padding: 30px;
            background-color: #f8f9fa;
            overflow-y: auto; /* Cuộn dọc cho riêng nội dung */
        }

        .page-header {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 1.5rem;
            color: #2c3e50;
        }

        .card-custom {
            background-color: #fff;
            padding: 1.5rem;
            border-radius: 0.5rem;
            box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,0.05);
            margin-bottom: 1.5rem;
            border: 1px solid #e9ecef;
            width: 100%; /* Ép card luôn tràn 100% cột */
        }

        .card-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: #344767;
            border-bottom: 2px solid #f1f3f5;
            padding-bottom: 0.75rem;
            margin-bottom: 1.25rem;
        }

        .info-label {
            font-weight: 600;
            color: #6c757d;
            font-size: 0.95rem;
        }

        .info-value {
            color: #212529;
            font-size: 0.95rem;
            font-weight: 500;
        }

        .action-buttons form {
            margin: 0;
        }
    </style>
</head>
<body>
    <div class="wrapper-layout">
        @* MENU TRÁI *@
        @await Html.PartialAsync("~/Areas/QuanLyDH/Views/Shared/_QuanLyDHSidebar.cshtml")

        @* NỘI DUNG PHẢI *@
        <div class="main-content-area">
            <div class="container-fluid p-0">

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="page-header m-0"><i class="fas fa-file-invoice text-primary me-2"></i>Chi Tiết Đơn Hàng #@Model.M_DonHang</h2>
                    <a asp-controller="QuanLyDH" asp-action="index" class="btn btn-outline-secondary shadow-sm">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
                    </a>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["InfoMessage"] != null)
                {
                    <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
                        <i class="fas fa-info-circle me-2"></i>@TempData["InfoMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <div class="card-custom border-top border-primary border-4">
                    <h5 class="card-title text-primary"><i class="fas fa-cogs me-2"></i>Thao Tác Quản Trị</h5>
                    <div class="d-flex flex-wrap gap-2 action-buttons">

                        @* GIỮ NGUYÊN HOÀN TOÀN CÁC ĐIỀU KIỆN CHỨC NĂNG CỦA BẠN *@

                        @if (Model.TrangThai == "Chưa xử lý" || Model.TrangThai == "Chờ xác nhận")
                        {
                            <a asp-action="EditOrder" asp-controller="QuanLyDH" asp-area="QuanLyDH" asp-route-id="@Model.M_DonHang" class="btn btn-warning shadow-sm"><i class="fas fa-edit me-1"></i> Sửa Đơn</a>
                            <form asp-action="UpdateStatus" asp-controller="QuanLyDH" asp-area="QuanLyDH" method="post">
                                <input type="hidden" name="id" value="@Model.M_DonHang" />
                                <input type="hidden" name="newStatusKey" value="confirm" />
                                <button type="submit" class="btn btn-success shadow-sm"><i class="fas fa-check me-1"></i> Xác Nhận</button>
                            </form>
                            <form asp-action="UpdateStatus" asp-controller="QuanLyDH" asp-area="QuanLyDH" method="post" onsubmit="return confirm('Bạn có chắc muốn hủy đơn hàng này?');">
                                <input type="hidden" name="id" value="@Model.M_DonHang" />
                                <input type="hidden" name="newStatusKey" value="cancel" />
                                <button type="submit" class="btn btn-danger shadow-sm"><i class="fas fa-times-circle me-1"></i> Hủy Đơn</button>
                            </form>
                        }
                        else if (Model.TrangThai == "Đã xác nhận")
                        {
                            <a asp-action="EditOrder" asp-controller="QuanLyDH" asp-area="QuanLyDH" asp-route-id="@Model.M_DonHang" class="btn btn-warning shadow-sm"><i class="fas fa-edit me-1"></i> Sửa Đơn</a>
                            <a asp-action="UpdateShippingInfo" asp-controller="QuanLyDH" asp-area="QuanLyDH" asp-route-id="@Model.M_DonHang" class="btn btn-primary shadow-sm"><i class="fas fa-truck me-1"></i> Cập nhật Vận Chuyển</a>
                            <form asp-action="UpdateStatus" asp-controller="QuanLyDH" asp-area="QuanLyDH" method="post" onsubmit="return confirm('Bạn có chắc muốn hủy đơn hàng này?');">
                                <input type="hidden" name="id" value="@Model.M_DonHang" />
                                <input type="hidden" name="newStatusKey" value="cancel" />
                                <button type="submit" class="btn btn-danger shadow-sm"><i class="fas fa-times-circle me-1"></i> Hủy Đơn</button>
                            </form>
                        }
                        else if (Model.TrangThai == "Đang xử lý")
                        {
                            <a asp-action="UpdateShippingInfo" asp-controller="QuanLyDH" asp-area="QuanLyDH" asp-route-id="@Model.M_DonHang" class="btn btn-primary shadow-sm"><i class="fas fa-truck me-1"></i> Cập nhật Vận Chuyển / Giao hàng</a>
                        }
                        else if (Model.TrangThai == "Đang giao hàng")
                        {
                            <form asp-action="UpdateStatus" asp-controller="QuanLyDH" asp-area="QuanLyDH" method="post">
                                <input type="hidden" name="id" value="@Model.M_DonHang" />
                                <input type="hidden" name="newStatusKey" value="complete" />
                                <button type="submit" class="btn btn-success shadow-sm"><i class="fas fa-check-double me-1"></i> Đã Giao/Hoàn Thành</button>
                            </form>
                        }
                        else if (Model.TrangThai == "Hoàn thành" && (paymentStatusText == "Đã thanh toán" || paymentStatusText == "Đã TT"))
                        {
                            <form asp-action="RefundPayment" asp-controller="QuanLyDH" asp-area="QuanLyDH" method="post" onsubmit="return confirm('Xác nhận hoàn tiền cho đơn hàng này?');">
                                <input type="hidden" name="id" value="@Model.M_DonHang" />
                                <button type="submit" class="btn btn-warning shadow-sm"><i class="fas fa-hand-holding-usd me-1"></i> Hoàn Tiền</button>
                            </form>
                        }
                        else if (Model.TrangThai == "Đã hủy" && (paymentStatusText == "Đã thanh toán" || paymentStatusText == "Đã TT"))
                        {
                            <form asp-action="RefundPayment" asp-controller="QuanLyDH" asp-area="QuanLyDH" method="post" onsubmit="return confirm('Đơn đã hủy. Xác nhận hoàn tiền?');">
                                <input type="hidden" name="id" value="@Model.M_DonHang" />
                                <button type="submit" class="btn btn-warning shadow-sm"><i class="fas fa-hand-holding-usd me-1"></i> Hoàn Tiền (Sau Hủy)</button>
                            </form>
                        }

                        <a asp-action="UpdatePaymentStatus" asp-controller="QuanLyThanhToan" asp-area="QuanLyDH" asp-route-id="@Model.M_DonHang" class="btn btn-info text-white shadow-sm">
                            <i class="far fa-credit-card me-1"></i> Cập nhật TT Thanh Toán
                        </a>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-7">
                        <div class="card-custom">
                            <h5 class="card-title"><i class="fas fa-info-circle text-primary me-2"></i>Thông Tin Đơn Hàng</h5>
                            <div class="row mb-2">
                                <div class="col-sm-4 info-label">Mã Đơn Hàng:</div>
                                <div class="col-sm-8 info-value fw-bold">@Model.M_DonHang</div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-sm-4 info-label">Ngày Đặt:</div>
                                <div class="col-sm-8 info-value">@Model.NgayDat.ToString("dd/MM/yyyy HH:mm:ss")</div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-sm-4 info-label">Trạng Thái Đơn Hàng:</div>
                                <div class="col-sm-8 info-value"><span class="@orderStatusBadgeClass py-1 px-2">@Model.TrangThai</span></div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-sm-4 info-label">Trạng Thái Thanh Toán:</div>
                                <div class="col-sm-8 info-value"><span class="@paymentStatusBadgeClass py-1 px-2 border">@paymentStatusText</span></div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-sm-4 info-label">Phương Thức Thanh Toán:</div>
                                <div class="col-sm-8 info-value">@(Model.PhuongThucThanhToan?.TenPhuongThuc ?? "N/A")</div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-sm-4 info-label">Tổng Tiền:</div>
                                <div class="col-sm-8 info-value fw-bold text-danger">@Model.TotalPrice.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) đ</div>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.Notes))
                            {
                                <div class="row mb-2">
                                    <div class="col-sm-4 info-label text-warning">Ghi Chú Đơn Hàng:</div>
                                    <div class="col-sm-8 info-value bg-light p-2 rounded border">@Model.Notes</div>
                                </div>
                            }
                        </div>

                        <div class="card-custom">
                            <h5 class="card-title"><i class="fas fa-user text-success me-2"></i>Thông Tin Khách Hàng (Người Đặt)</h5>
                            <div class="row mb-2">
                                <div class="col-sm-4 info-label">Tên Khách Hàng:</div>
                                <div class="col-sm-8 info-value">@(Model.KhachHang?.Ten_KhachHang ?? "N/A")</div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-sm-4 info-label">Số Điện Thoại:</div>
                                <div class="col-sm-8 info-value">@(Model.KhachHang?.SDT_KhachHang ?? "N/A")</div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-sm-4 info-label">Email:</div>
                                <div class="col-sm-8 info-value text-primary">@(Model.KhachHang?.Email_KhachHang ?? "N/A")</div>
                            </div>
                        </div>

                        <div class="card-custom">
                            <h5 class="card-title"><i class="fas fa-map-marker-alt text-danger me-2"></i>Thông Tin Giao Hàng (Người Nhận)</h5>
                            <div class="row mb-2">
                                <div class="col-sm-4 info-label">Tên Người Nhận:</div>
                                <div class="col-sm-8 info-value">@(Model.KhachHang?.Ten_KhachHang ?? "N/A")</div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-sm-4 info-label">SĐT Người Nhận:</div>
                                <div class="col-sm-8 info-value fw-bold">@(Model.KhachHang?.SDT_KhachHang ?? "N/A")</div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-sm-4 info-label">Địa Chỉ Giao Hàng:</div>
                                <div class="col-sm-8 info-value">@Model.ShippingAddress</div>
                            </div>
                            @if (Model.VanChuyen != null)
                            {
                                <div class="row mb-2 mt-3 pt-2 border-top">
                                    <div class="col-sm-4 info-label">Đơn Vị Vận Chuyển:</div>
                                    <div class="col-sm-8 info-value"><span class="badge bg-secondary">@Model.VanChuyen.DonViVanChuyen</span></div>
                                </div>
                                <div class="row mb-2">
                                    <div class="col-sm-4 info-label">Mã Vận Đơn:</div>
                                    <div class="col-sm-8 info-value fw-bold text-primary">@Model.M_VanDon</div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col-lg-5">
                        <div class="card-custom">
                            <h5 class="card-title"><i class="fas fa-box-open text-warning me-2"></i>Chi Tiết Sản Phẩm</h5>
                            @if (Model.ChiTietDatHangs != null && Model.ChiTietDatHangs.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover table-bordered align-middle">
                                        <thead class="table-light">
                                            <tr>
                                                <th scope="col">Sản Phẩm</th>
                                                <th scope="col" class="text-center">KL</th>
                                                <th scope="col" class="text-end">Thành Tiền</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.ChiTietDatHangs)
                                            {
                                                <tr>
                                                    <td>
                                                        <div class="d-flex align-items-center">
                                                            @if (item.SanPham != null && !string.IsNullOrEmpty(item.SanPham.AnhSanPham))
                                                            {
                                                                <img src="~/@item.SanPham.AnhSanPham" alt="@item.SanPham.TenSanPham" class="rounded border shadow-sm me-2" style="width: 40px; height: 40px; object-fit: cover;" />
                                                            }
                                                            <span class="fw-medium">@(item.SanPham?.TenSanPham ?? "Sản phẩm không xác định")</span>
                                                        </div>
                                                    </td>
                                                    <td class="text-center">@item.Khoiluong</td>
                                                    <td class="text-end">@((item.Khoiluong * item.GiaDatHang).ToString("N0")) đ</td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot class="table-light">
                                            <tr>
                                                <td colspan="2" class="text-end fw-bold text-muted">Tổng sản phẩm:</td>
                                                <td class="text-end fw-bold">@Model.ChiTietDatHangs.Sum(c => c.Khoiluong * c.GiaDatHang).ToString("N0") đ</td>
                                            </tr>
                                            <tr>
                                                <td colspan="2" class="text-end fw-bold text-muted">Phí vận chuyển:</td>
                                                <td class="text-end fw-bold">0 đ</td>
                                            </tr>
                                            <tr>
                                                <td colspan="2" class="text-end fw-bold text-primary h6 mb-0 py-3">TỔNG THANH TOÁN:</td>
                                                <td class="text-end fw-bold text-danger h6 mb-0 py-3">@Model.TotalPrice.ToString("N0") đ</td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning text-center"><i class="fas fa-exclamation-circle me-2"></i>Không có chi tiết sản phẩm cho đơn hàng này.</div>
                            }
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>